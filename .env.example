# Port the Node server listens on (nginx proxies to this).
PORT=8742

# Bind address. Keep 127.0.0.1 when nginx terminates TLS in front.
# Use 0.0.0.0 only if you expose the Node server directly.
BIND=127.0.0.1

# Binaries. Override if they are not on PATH.
YT_DLP=yt-dlp
FFMPEG=ffmpeg

# Optional: Netscape-format cookie jar for yt-dlp.
# YouTube increasingly demands this on datacenter IPs (DigitalOcean included)
# or it answers with "Sign in to confirm you're not a bot".
# YT_DLP_COOKIES=/opt/teslos/cookies.txt

# Which YouTube clients yt-dlp may impersonate, tried in order until one is
# allowed through. The first four need neither authentication nor the JS
# player, so they sidestep the proof-of-origin check that usually blocks
# datacenter IPs. Leave unset unless you are debugging.
# YT_DLP_CLIENTS=tv_simply,android_vr,ios,android,tv,mweb,web_safari,default

# Default quality preset for new sessions: 360 | 480 | 720 | 1080
DEFAULT_QUALITY=480

# Cap concurrent transcodes. Each one is a full ffmpeg process; a 1 vCPU
# droplet realistically handles one 480p session.
MAX_SESSIONS=2
